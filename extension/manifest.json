{
  "manifest_version": 3,
  "name": "Unsnitch — clean X links",
  "short_name": "Unsnitch",
  "version": "1.1.0",
  "description": "Stop X from snitching on your links. Strips share-tracking params (?s=, t=, a=) from X (Twitter) links you copy or share.",
  "homepage_url": "https://github.com/xBrokkr/unsnitch",
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "core/clean.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "core/clean.js",
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "isolated.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Unsnitch",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "unsnitch@xbrokkr",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
